# oezCMS environment configuration
#
# Copy to .env and adjust. Never commit .env.
# Format and all application values: docs/development/environment.md

# Application
# One of: production, staging, development, testing (default: production)
APP_ENV=development
# Must be false in production
APP_DEBUG=true

# Database, runtime account
# All connection options: docs/deployment/database-connection.md
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=oezcms
DB_USERNAME=oezcms
DB_PASSWORD=

# Optional: a separate account for db:deploy
# See docs/deployment/database-privileges.md
# DB_MIGRATION_USERNAME=
# DB_MIGRATION_PASSWORD=
