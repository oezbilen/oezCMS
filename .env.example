# oezCMS environment configuration
#
# Copy to .env and adjust. Never commit .env.
# Format, accounts and all application values: docs/development/environment.md

# Application
# One of: production, staging, development, testing (default: production)
APP_ENV=development
# Must be false in production
APP_DEBUG=true

# Database, runtime account (data and routine calls, no DDL)
# All connection options: docs/deployment/database-connection.md
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=oezcms
DB_USERNAME=oezcms_runtime
DB_PASSWORD=

# Database, deploy account used by db:deploy (both values or neither)
# See docs/deployment/database-privileges.md
DB_MIGRATION_USERNAME=oezcms_deploy
DB_MIGRATION_PASSWORD=
